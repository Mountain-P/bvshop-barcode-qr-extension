{
  "manifest_version": 3,
  "name": "BVSHOP 條碼＋商品 QR Code",
  "version": "2.0.0",
  "description": "為 BVSHOP 商品設計並列印包含條碼與商品 QR Code 的自訂標籤。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://bvshop-manage.bvshop.tw/*"
  ],
  "action": {
    "default_title": "BVSHOP 條碼＋QR",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bvshop-manage.bvshop.tw/*"
      ],
      "js": [
        "vendor/qrcode-generator.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
